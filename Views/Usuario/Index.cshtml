@model IEnumerable<FichaOnline.Models.Tbusuarios>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioNome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioCpf)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioStatus)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.UsuarioIncEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioAltEm)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.PerfilAcesso)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UsuarioNome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsuarioEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsuarioCpf)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsuarioStatus)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.UsuarioIncEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsuarioAltEm)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.PerfilAcesso.PerfilAcessoDesc)
            </td>
            <td>
                <a asp-action="Editar" asp-route-id="@item.UsuarioId">Edit</a> |
                <a asp-action="Detalhes" asp-route-id="@item.UsuarioId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.UsuarioId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@model FichaOnline.Models.ViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TBFicha</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-controller="Ficha" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <select asp-for="TBFicha.FichaCatId" class="form-control" id="fichaCatSelect" asp-items="ViewBag.CatId"></select>
            </div>
            <div class="form-group">
                <label asp-for="TBFicha.AluId" class="control-label"></label>
                <select asp-for="TBFicha.AluId" class="form-control" asp-items="ViewBag.AluId"></select>
            </div>
            <div class="form-group">
                <label asp-for="TBFicha.FichaEscOrigemUnidadeId" class="control-label"></label>
                <select asp-for="TBFicha.FichaEscOrigemUnidadeId" class="form-control" asp-items="ViewBag.FichaEscOrigemUnidadeId"></select>
            </div>
            <div class="form-group">
                <label asp-for="TBFicha.FichaStsId" class="control-label"></label>
                <input asp-for="TBFicha.FichaStsId" class="form-control" />
                <span asp-validation-for="TBFicha.FichaStsId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TBFicha.FichaDtaIni" class="control-label"></label>
                <input asp-for="TBFicha.FichaDtaIni" class="form-control" />
                <span asp-validation-for="TBFicha.FichaDtaIni" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TBFicha.FichaIncPor" class="control-label"></label>
                <input asp-for="TBFicha.FichaIncPor" class="form-control" />
                <span asp-validation-for="TBFicha.FichaIncPor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TBFicha.FichaIncEm" class="control-label"></label>
                <input asp-for="TBFicha.FichaIncEm" class="form-control" />
                <span asp-validation-for="TBFicha.FichaIncEm" class="text-danger"></span>
            </div>

            <br /><br />



            <div class="form-control checkboxes-container">
                <h3>Selecione os itens desejados:</h3>

                <ul>
                    @for (var i = 0; i < Model.ListCategoriaOpcoes.Count; i++)
                    {
                        <li>
                            @Html.HiddenFor(m => Model.ListCategoriaOpcoes[i].CatOpcId)
                            @Html.CheckBoxFor(m => Model.ListCategoriaOpcoes[i].Selecionado)
                            @Model.ListCategoriaOpcoes[i].CatOpcDesc
                        </li>
                    }
                </ul>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

                @Html.DisplayNameFor(model => model.FichaDtaFim)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FichaIncPor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FichaIncEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FichaAltPor)

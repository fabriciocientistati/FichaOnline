            <td>
                @Html.DisplayFor(modelItem => item.FichaDtaFim)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FichaIncPor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FichaIncEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FichaAltPor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FichaAltEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FichaEscOrigemUnidade.UnidadeId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FichaId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FichaId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FichaId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

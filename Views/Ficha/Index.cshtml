            <th>
                @Html.DisplayNameFor(model => model.FichaAltEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FichaEscOrigemUnidade)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {

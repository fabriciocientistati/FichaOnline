@model List<TBCategoriaOpcoes>

@{
    ViewData["Title"] = "Index";
}

<form asp-controller="Ficha" asp-action="SalvarSelecionados">

    <h3>Selecione os itens desejados:</h3>
    <ul>
        @for (var i = 0; i < Model.Count; i++)
        {
            <li>
                @Html.HiddenFor(m => Model[i].CatOpcId)
                @Html.CheckBoxFor(m => Model[i].Selecionado)
                @Model[i].CatOpcDesc
            </li>
        }
    </ul>
    <input type="submit" value="Salvar Selecionados" />

</form>